# Copy to .env and fill in real values. Never commit .env.
DB_URL=jdbc:mysql://localhost:3306/natura?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
# Generate with: openssl rand -base64 48
JWT_SECRET=your-base64-secret
# Optional: create the first admin account at startup
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
